# All settings are prefixed YTDL_. Everything here is optional; with no configuration the
# service runs open and uploads to a file host on localhost.

# --- service ---
# YTDL_HOST=0.0.0.0
# YTDL_PORT=8000
# YTDL_LOG_LEVEL=info
# Hash of the API key. Callers present the key itself; this is only its digest.
# Generate with: python -m ytdl_rest keygen
# YTDL_API_KEY_HASH=

# --- file host ---
# Any host speaking the girafiles API: multipart POST of a file field, answering
# {"status": "success", "url": ...}.
# YTDL_UPLOAD_URL=http://girafiles:8080/api/
# YTDL_UPLOAD_FIELD=file
# The name callers can reach, when uploads go to an internal address.
# YTDL_UPLOAD_PUBLIC_BASE=https://s.example.com
# YTDL_UPLOAD_BASIC_AUTH=user:password
# YTDL_UPLOAD_TIMEOUT_SECONDS=300

# --- limits ---
# Keep at or below what the file host accepts; larger media is refused mid-download.
# YTDL_MAX_FILE_BYTES=524288000
# Longest media accepted, in seconds. 0 disables the check.
# YTDL_MAX_DURATION_SECONDS=0
# YTDL_MAX_CONCURRENT_DOWNLOADS=2
# YTDL_DOWNLOAD_TIMEOUT_SECONDS=1800
# YTDL_ALLOW_PLAYLIST=false

# --- extraction ---
# YTDL_COOKIES_FILE=/etc/ytdl/cookies.txt
# A proof-of-origin token provider (bgutil), which YouTube increasingly requires.
# YTDL_POT_PROVIDER_URL=http://127.0.0.1:4416
# YTDL_PROXY=
# YTDL_WORK_DIR=/tmp
# YTDL_USER_AGENT=
# Anything else yt-dlp accepts, as JSON. Server-side only.
# YTDL_EXTRA_OPTIONS={"concurrent_fragment_downloads": 4}

# --- defaults for request fields the caller leaves out ---
# YTDL_DEFAULT_MODE=video
# YTDL_DEFAULT_VIDEO_QUALITY=best
# YTDL_DEFAULT_VIDEO_FORMAT=mp4
# YTDL_DEFAULT_AUDIO_QUALITY=best
# YTDL_DEFAULT_AUDIO_FORMAT=mp3
